[1.090201, "o", " \u001b[32m✓\u001b[39m \u001b[2mtest/\u001b[22madvise\u001b[2m.test.ts\u001b[22m\u001b[2m (33)\u001b[22m\r\n   \u001b[32m✓\u001b[39m advise() — property-based tests\u001b[2m (33)\u001b[22m\r\n"]
[1.090336, "o", "     \u001b[32m✓\u001b[39m Property 1: rain conditions always mention umbrella (傘)\r\n     \u001b[32m✓\u001b[39m Property 2: precipitationProbability ≥ 60 always produces umbrella advice\r\n     \u001b[32m✓\u001b[39m Property 3: cold conditions (< 10 °C, low precip) never produce light-clothing advice\r\n     \u001b[32m✓\u001b[39m Property 4: all outputs are ≤ 40 Unicode code points\r\n     \u001b[32m✓\u001b[39m Property 5: advise() is deterministic (same input → same output)\r\n     \u001b[32m✓\u001b[39m Property 6: wmoToCondition never throws for any integer 0–200\r\n     \u001b[32m✓\u001b[39m Property 7: warm dry conditions (≥ 20 °C, low precip) do not advise heavy coats\r\n     \u001b[32m✓\u001b[39m example-based rule coverage\u001b[2m (9)\u001b[22m\r\n       \u001b[32m✓\u001b[39m rain + cold\r\n       \u001b[32m✓\u001b[39m rain + mild\r\n       \u001b[32m✓\u001b[39m rain + warm\r\n       \u001b[32m✓\u001b[39m high precip + mild\r\n       \u001b[32m✓\u001b[39m high precip + warm\r\n       \u001b[32m✓\u001b[39m snow + cold\r\n       \u001b[32m✓\u001b[39m cold clear\r\n       \u001b[32m✓\u001b[39m mild\r\n       \u001b[32m✓\u001b[39m warm\r\n     \u001b[32m✓\u001b[39m wmoToCondition — spot checks\u001b[2m (17)\u001b[22m\r\n       \u001b[32m✓\u001b[39m WMO 0 → Clear\r\n       \u001b[32m✓\u001b[39m WMO 1 → Clouds\r\n       \u001b[32m✓\u001b[39m WMO 3 → Clouds\r\n       \u001b[32m✓\u001b[39m WMO 45 → Fog\r\n       \u001b[32m✓\u001b[39m WMO 51 → Drizzle\r\n       \u001b[32m✓\u001b[39m WMO 57 → Drizzle\r\n       \u001b[32m✓\u001b[39m WMO 61 → Rain\r\n       \u001b[32m✓\u001b[39m WMO 67 → Rain\r\n       \u001b[32m✓\u001b[39m WMO 71 → Snow\r\n       \u001b[32m✓\u001b[39m WMO 77 → Snow\r\n       \u001b[32m✓\u001b[39m WMO 80 → Rain\r\n       \u001b[32m✓\u001b[39m WMO 82 → Rain\r\n       \u001b[32m✓\u001b[39m WMO 85 → Snow\r\n       \u001b[32m✓\u001b[39m WMO 86 → Snow\r\n       \u001b[32m✓\u001b[39m WMO 95 → Thunderstorm\r\n       \u001b[32m✓\u001b[39m WMO 99 → Thunderstorm\r\n       \u001b[32m✓\u001b[39m WMO 100 → Unknown\r\n"]
